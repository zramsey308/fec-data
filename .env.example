# Copy to .env and fill in real values — never commit .env itself.

# Google Drive — use ONE of these two methods:
# Option 1 (recommended for Render): paste the full service-account JSON
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option 2 (local dev): path to the key file
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# The Drive folder containing your FEC bulk ZIP files
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id-here

# Election cycles to process — comma-separated years.
# Files are matched by 2-digit suffix (indiv20.zip, cn24.zip, etc.)
FEC_CYCLES=2020,2022,2024,2026

# Default single cycle (used as fallback)
FEC_CYCLE=2024

# Rows per batch when parsing (default 50000)
FEC_CHUNK_SIZE=50000
